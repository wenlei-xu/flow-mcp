# Copy these values into the service environment. Never commit real secrets.
GFLOW_CLI_SRC=../gflow-cli/src
GFLOW_CLI_HOME=./.gflow-cli
GFLOW_CLI_OUTPUT_DIR=./output
# Optional S3-compatible/R2 or GCS prefix. Leave empty for local output.
# GFLOW_CLI_STORAGE_URI=s3://bucket/gflow/
# For R2/S3, set these in the deployment .env (never in browser requests).
# AWS_ACCESS_KEY_ID=replace-with-storage-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
# AWS_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
GFLOW_CLI_DAEMON_TOKEN=replace-with-a-long-random-daemon-token
# Local MCP spend-safety bucket; this does not increase Google's quota.
GFLOW_CLI_GENERATION_RATE_CAPACITY=8
GFLOW_CLI_GENERATION_RATE_REFILL_SECONDS=20
GFLOW_STUDIO_API_KEY=replace-with-a-long-random-api-key
GFLOW_STUDIO_ADMIN_USER=admin
GFLOW_STUDIO_ADMIN_PASSWORD=replace-with-a-long-random-password
GFLOW_STUDIO_SESSION_SECRET=replace-with-a-long-random-secret
GFLOW_STUDIO_MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
GFLOW_STUDIO_PUBLIC_BASE_URL=https://gflow.example.com
GFLOW_STUDIO_CORS_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
# Used by systemd backup.sh; Docker Compose supplies its own volume paths.
GFLOW_STUDIO_DB_PATH=./gflow-studio.db
GFLOW_STUDIO_UPLOAD_DIR=./uploads
GFLOW_STUDIO_BACKUP_DIR=./backups
GFLOW_STUDIO_MCP_UPSTREAM_URL=http://127.0.0.1:18080/mcp
GFLOW_STUDIO_QUEUE_WORKERS=4
GFLOW_STUDIO_IMAGE_WORKERS=8
GFLOW_STUDIO_VIDEO_WORKERS=4
GFLOW_STUDIO_WORKER_LEASE_SECONDS=45
GFLOW_STUDIO_GENERATION_TIMEOUT_SECONDS=1800
GFLOW_STUDIO_MEDIA_TTL_SECONDS=86400
GFLOW_STUDIO_ASSET_RETENTION_SECONDS=604800
GFLOW_STUDIO_ASSET_MAX_BYTES=26214400
GFLOW_STUDIO_ASSET_MAX_TOTAL_BYTES=2147483648
GFLOW_STUDIO_RATE_LIMIT_PER_MINUTE=180
